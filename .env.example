# Copy to .env and adjust. All app settings use the STATORA_ prefix.

# Required in production: long random value (e.g. `openssl rand -hex 32`).
# Signs sessions and encrypts auth-provider secrets stored in the database; changing it
# logs everybody out and makes stored LDAP/OIDC/SAML secrets unreadable.
STATORA_SECRET_KEY=

# Public URL of this instance; used for OIDC/SAML callback URLs.
STATORA_BASE_URL=http://localhost:8000

# Password for the bundled PostgreSQL container (docker-compose.yml).
POSTGRES_PASSWORD=

# Set to true when served over HTTPS (marks the session cookie Secure).
STATORA_SECURE_COOKIES=false

# Host port for docker-compose.yml.
# STATORA_HTTP_PORT=8000

# Optional
# STATORA_ROLE=all                     # all | web | worker
# STATORA_HEARTBEAT_RETENTION_DAYS=30
# STATORA_PAGE_CACHE_TTL=30
# STATORA_DISABLE_LOCAL_LOGIN=false    # local admins can always sign in
# STATORA_LOGIN_RATE_LIMIT=10          # attempts per window per IP / username
# STATORA_LOGIN_RATE_WINDOW=300

# When running outside docker-compose (e.g. `statora dev`), point at your services:
# STATORA_DATABASE_URL=postgresql+asyncpg://statora:statora@localhost:5432/statora
# STATORA_REDIS_URL=redis://localhost:6379/0
