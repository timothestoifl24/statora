# Copy to secrets.env (never commit it). Generate values with: openssl rand -hex 32
# Replace this example value: `statora serve` refuses to start with it.
STATORA_SECRET_KEY=change-me-to-a-long-random-value
POSTGRES_PASSWORD=change-me
# Must contain the same password as POSTGRES_PASSWORD.
STATORA_DATABASE_URL=postgresql+asyncpg://statora:change-me@postgres:5432/statora
